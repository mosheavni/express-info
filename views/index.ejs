<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Express Debug</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="p-4">
  <div class="container">
    <div class="p-4 mb-4 bg-light rounded-3">
      <h2>Hello, world!</h2>
      <% if (process.env.MESSAGE) { %>
        <h3><%= process.env.MESSAGE %></h3>
      <% } %>
      <p class="lead">Hostname: <%= process.env.HOSTNAME %></p>
      <dl class="row">
        <% for (let key in descriptions) { %>
          <dt class="col-sm-3"><%= key %></dt>
          <dd class="col-sm-9"><%= descriptions[key] %></dd>
        <% } %>
      </dl>

      <% if (Object.keys(queryParams).length > 0) { %>
        <h4>Query Params</h4>
        <ul class="list-group mb-3">
          <% for (let key in queryParams) { %>
            <li class="list-group-item"><strong><%= key %></strong>: <%= queryParams[key] %></li>
          <% } %>
        </ul>
      <% } %>
    </div>

    <h4>Headers</h4>
    <table class="table table-hover table-bordered">
      <thead class="table-dark">
        <tr>
          <th>Key</th>
          <th>Value</th>
        </tr>
      </thead>
      <tbody>
        <% for (let key in headers) { %>
          <tr>
            <td><%= key %></td>
            <td><%= headers[key] %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>
